{
  "_comment": "Chromium enterprise-style recommended policies for Horizon. Map keys to the policy mechanism available on your pin (registry on Windows). Replace example.com update endpoints before shipping.",
  "BrowserSignin": 0,
  "SyncDisabled": true,
  "PasswordManagerEnabled": true,
  "AutofillAddressEnabled": true,
  "SafeBrowsingEnabled": true,
  "SafeBrowsingProtectionLevel": 1,
  "DefaultBrowserSettingEnabled": true,
  "HomepageLocation": "about:blank",
  "HomepageIsNewTabPage": true,
  "RestoreOnStartup": 1,
  "DefaultSearchProviderEnabled": true,
  "DefaultSearchProviderName": "DuckDuckGo",
  "DefaultSearchProviderSearchURL": "https://duckduckgo.com/?q={searchTerms}",
  "ExtensionInstallBlocklist": [],
  "ExtensionInstallAllowlist": [],
  "DeveloperToolsAvailability": 1,
  "HardwareAccelerationModeEnabled": true,
  "BackgroundModeEnabled": false,
  "MetricsReportingEnabled": false,
  "RemoteAccessHostFirewallTraversal": false,
  "DownloadRestrictions": 0,
  "UrlKeyedAnonymizedDataCollectionEnabled": false,
  "HorizonUpdateUrlPlaceholder": "https://example.com/horizon/update",
  "RelaunchNotification": 1,
  "RelaunchNotificationPeriod": 86400000
}
